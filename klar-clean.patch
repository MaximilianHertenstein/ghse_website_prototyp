@@ -0,0 +1,1090 @@
+/* GHSE – Gestaltungsvariante „klar“ (Design-System „Clean“)
+   ============================================================
+   Gleiche Struktur wie die Hauptvariante: gleiche Templates, Menüs,
+   Dropdowns und Inhalte. Nur das Aussehen folgt dem Design-System „Clean“:
+   minimal, viel Weißraum, gut lesbare Schrift, begrenzte Palette.
+   Beschreibung, Regeln und QA-Checkliste: DESIGN-KLAR.md.
+
+   Technik: Die Datei wird nur gebaut, wenn hugo-klar.toml gilt
+   (params.design = "klar"), und zwar NACH main.css. Jede Regel trägt das
+   Präfix  :root[data-design="klar"]  und schlägt damit main.css, ohne dass
+   dort etwas geändert werden muss. Kein CSS-Nesting: ältere Tablets und
+   Telefone verstehen es nicht.
+
+   Pflegehinweis: Was der helle Satz in den Farb-Tokens setzt, setzt der
+   dunkle Satz ebenfalls – und jedes Token, das main.css im Dunkeln setzt,
+   setzt er auch. Sonst scheint der dunkle Satz aus main.css durch.
+   qa/kontrast_klar.py prüft das. */
+
+/* ---------- Tokens, hell ---------- */
+
+:root[data-design="klar"] {
+  /* Semantische Ebene (Clean). Rohwerte stehen nur hier. */
+  --primaer: #1e40af;            /* Flächen mit weißer Schrift, Primäraktion (8,7:1) */
+  --primaer-text: #1e40af;       /* Links und Textakzente (8,7:1 auf Weiß) */
+  --primaer-akzent: #3b82f6;     /* Clean-Primärblau: Linien, Balken, Icons – nie Text */
+  --primaer-hell: #dbeafe;       /* Hover- und Markierungsfläche, mit dunkler Schrift */
+  --aktion: #1e40af;             /* Fläche der Primäraktion */
+  --aktion-schrift: #ffffff;
+  --text: #111827;               /* Clean: text */
+  --text-leise: #4b5563;         /* Zweittext (7,6:1) */
+  --flaeche-leise: #f9fafb;
+  --rand-leise: #e5e7eb;         /* Trennlinien und Kartenränder */
+  --erfolg: #166534;             /* Clean #16A34A, für Text abgedunkelt */
+  --warnung: #92400e;            /* Clean #D97706, für Text abgedunkelt */
+  --fehler: #991b1b;             /* Clean #DC2626, für Text abgedunkelt */
+
+  /* Abbildung auf die Tokens aus main.css */
+  --papier: #ffffff;
+  --papier2: var(--flaeche-leise);
+  --schrift: var(--text);
+  --grau: var(--text-leise);
+  --rand: #4b5563;               /* Rand interaktiver Elemente (7,6:1) */
+  --linie: var(--rand-leise);
+  --link: var(--primaer-text);
+  --blau: var(--primaer);
+  --gelb: var(--primaer-hell);
+  --orange: var(--primaer-akzent);
+  --orange-tief: var(--primaer-text);
+  --tinte: var(--text);
+  --schatten-farbe: transparent;
+  --haarlinie: rgba(17, 24, 39, 0.12);
+  --marker-hintergrund: transparent;
+  --kategorie-teilzeit: var(--rand-leise);
+  --hinweis-flaeche: #eff6ff;
+  --hinweis-rand: var(--primaer);
+  --warn-flaeche: #fffbeb;
+  --warn-rand: var(--warnung);
+
+  /* Die fünf Werte der Schule sind Inhalt und behalten ihre Markenfarben. */
+  --wert-blau: #114c92;
+  --wert-gelb: #f6dc56;
+  --wert-orange: #ee7330;
+
+  --fuss-flaeche: #f3f4f6;
+  --fuss-schrift: var(--text);
+  --fuss-titel: var(--text);
+  --fuss-linie: var(--rand-leise);
+  --fuss-link: var(--primaer-text);
+  --fuss-haarlinie: var(--rand-leise);
+  --fuss-leiste-flaeche: #e5e7eb;
+  --fuss-leiste-schrift: #374151;
+  color-scheme: light;
+
+  /* Form */
+  --rahmen: 2px solid var(--rand);
+  --schatten: none;
+  --schatten-klein: none;
+  --rund: 8px;
+
+  /* Schrift: Clean-Skala 14/16/20/24/32, ergänzt um 18 (Bedienelemente),
+     40 und 48 (Überschrift, Hero). Roboto für Text, Poppins für Überschriften. */
+  --schriftstapel: "Roboto", system-ui, -apple-system, "Segoe UI", Arial, sans-serif;
+  --schriftstapel-display: "Poppins", "Roboto", system-ui, -apple-system, "Segoe UI", Arial, sans-serif;
+  --t-xs: 0.875rem;
+  --t-s: 1rem;
+  --t-ui: 1.125rem;
+  --t-m: 1.25rem;
+  --t-h3: clamp(1.25rem, 1.8vw, 1.5rem);
+  --t-h2: clamp(1.5rem, 3vw, 2rem);
+  --t-h1: clamp(2rem, 4vw, 2.5rem);
+  --t-display: clamp(2rem, 5vw, 3rem);
+}
+
+/* Kopfhöhe gemessen (Leiste + Logozeile); steuert Sprungleiste und Ankerabstand. */
+@media (min-width: 901px) {
+  :root[data-design="klar"] {
+    --kopfhoehe: 7.9rem;
+  }
+}
+
+@media (max-width: 900px) {
+  :root[data-design="klar"] {
+    --kopfhoehe: 4.5625rem;
+  }
+}
+
+@media (max-width: 640px) {
+  :root[data-design="klar"] {
+    --t-ui: 1rem;
+    --t-m: 1.125rem;
+  }
+}
+
+/* ---------- Tokens, dunkel (gleiche Namen wie oben) ---------- */
+
+@media (prefers-color-scheme: dark) {
+  :root[data-design="klar"]:not([data-theme="light"]) {
+    --primaer: #1e40af;
+    --primaer-text: #93c5fd;
+    --primaer-akzent: #3b82f6;
+    --primaer-hell: #dbeafe;
+    --aktion: #93c5fd;
+    --aktion-schrift: #111827;
+    --text: #f9fafb;
+    --text-leise: #d1d5db;
+    --flaeche-leise: #1f2937;
+    --rand-leise: #374151;
+    --erfolg: #86efac;
+    --warnung: #fcd34d;
+    --fehler: #fca5a5;
+
+    --papier: #111827;
+    --papier2: var(--flaeche-leise);
+    --flaeche: var(--flaeche-leise);
+    --schrift: var(--text);
+    --grau: var(--text-leise);
+    --rand: #9ca3af;
+    --linie: var(--rand-leise);
+    --link: var(--primaer-text);
+    --blau: var(--primaer);
+    --gelb: var(--primaer-hell);
+    --orange: var(--primaer-akzent);
+    --orange-tief: var(--primaer-text);
+    --tinte: #111827;
+    --schatten-farbe: transparent;
+    --haarlinie: rgba(255, 255, 255, 0.14);
+    --marker-hintergrund: transparent;
+    --kategorie-teilzeit: var(--rand-leise);
+    --hinweis-flaeche: #172554;
+    --hinweis-rand: var(--primaer-text);
+    --warn-flaeche: #451a03;
+    --warn-rand: var(--warnung);
+
+    --wert-blau: #114c92;
+    --wert-gelb: #f6dc56;
+    --wert-orange: #ee7330;
+
+    --fuss-flaeche: #0b1220;
+    --fuss-schrift: var(--text);
+    --fuss-titel: var(--text);
+    --fuss-linie: var(--rand-leise);
+    --fuss-link: var(--primaer-text);
+    --fuss-haarlinie: rgba(255, 255, 255, 0.14);
+    --fuss-leiste-flaeche: #060b14;
+    --fuss-leiste-schrift: #d1d5db;
+    color-scheme: dark;
+  }
+}
+
+:root[data-design="klar"][data-theme="dark"] {
+  --primaer: #1e40af;
+  --primaer-text: #93c5fd;
+  --primaer-akzent: #3b82f6;
+  --primaer-hell: #dbeafe;
+  --aktion: #93c5fd;
+  --aktion-schrift: #111827;
+  --text: #f9fafb;
+  --text-leise: #d1d5db;
+  --flaeche-leise: #1f2937;
+  --rand-leise: #374151;
+  --erfolg: #86efac;
+  --warnung: #fcd34d;
+  --fehler: #fca5a5;
+
+  --papier: #111827;
+  --papier2: var(--flaeche-leise);
+  --flaeche: var(--flaeche-leise);
+  --schrift: var(--text);
+  --grau: var(--text-leise);
+  --rand: #9ca3af;
+  --linie: var(--rand-leise);
+  --link: var(--primaer-text);
+  --blau: var(--primaer);
+  --gelb: var(--primaer-hell);
