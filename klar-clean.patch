+  transform: none;
+  box-shadow: none;
+  border-color: var(--primaer-akzent);
+}
+
+:root[data-design="klar"] .service h3 {
+  font-size: var(--t-h3);
+}
+
+:root[data-design="klar"] .zeile {
+  border: 1px solid var(--rand-leise);
+  border-radius: var(--rund);
+  box-shadow: none;
+}
+
+:root[data-design="klar"] .zeile:hover,
+:root[data-design="klar"] .zeile:focus-within {
+  transform: none;
+  box-shadow: none;
+  border-color: var(--primaer-akzent);
+}
+
+:root[data-design="klar"] .zeile__titel {
+  font-size: var(--t-h3);
+}
+
+:root[data-design="klar"] .kasten {
+  border: 1px solid var(--rand-leise);
+  border-radius: var(--rund);
+  box-shadow: none;
+}
+
+:root[data-design="klar"] .kasten h2 {
+  font-size: var(--t-s);
+  border-bottom: 1px solid var(--rand-leise);
+}
+
+:root[data-design="klar"] .kasten__kontakt {
+  border-top: 1px solid var(--rand-leise);
+}
+
+/* „kasten--gelb“ erzwang weiße Innenflächen und schwarze Schrift; hier erbt
+   der Inhalt die Tokens der Seite, die Fläche selbst ist ein neutraler Ton. */
+:root[data-design="klar"] .kasten--gelb {
+  --flaeche: inherit;
+  --schrift: inherit;
+  --grau: inherit;
+  --rand: inherit;
+  --schatten-farbe: inherit;
+  --link: inherit;
+  --orange-tief: inherit;
+  --rahmen: inherit;
+  --schatten: inherit;
+  --schatten-klein: inherit;
+  background: var(--papier2);
+  color: var(--schrift);
+}
+
+:root[data-design="klar"] .hinweis {
+  border: 1px solid var(--hinweis-rand);
+  border-radius: var(--rund);
+  box-shadow: none;
+}
+
+:root[data-design="klar"] .hinweis__titel {
+  color: var(--schrift);
+}
+
+:root[data-design="klar"] .hinweis p {
+  font-size: var(--t-ui);
+}
+
+:root[data-design="klar"] .infozeile {
+  border: 1px solid var(--rand-leise);
+  border-radius: var(--rund);
+  box-shadow: none;
+}
+
+:root[data-design="klar"] .infozeile__titel {
+  font-size: var(--t-h3);
+}
+
+:root[data-design="klar"] .konten__titel {
+  font-size: var(--t-ui);
+}
+
+/* ---------- Bilder ---------- */
+
+:root[data-design="klar"] .bild img,
+:root[data-design="klar"] .seitenleiste__bild img,
+:root[data-design="klar"] .beitrag__lupe img,
+:root[data-design="klar"] .schulleben img {
+  border: 1px solid var(--rand-leise);
+  border-radius: var(--rund);
+  box-shadow: none;
+}
+
+:root[data-design="klar"] .schulleben li:nth-child(3n + 1) img,
+:root[data-design="klar"] .schulleben li:nth-child(3n + 3) img {
+  transform: none;
+}
+
+:root[data-design="klar"] .lupe__plakette {
+  border: 2px solid var(--tinte);
+  border-radius: 4px;
+  box-shadow: none;
+  font-size: var(--t-s);
+}
+
+:root[data-design="klar"] .beitrag__lupe:hover .lupe__plakette,
+:root[data-design="klar"] .beitrag__lupe:focus-visible .lupe__plakette {
+  transform: none;
+  box-shadow: none;
+}
+
+:root[data-design="klar"] .video__knopf {
+  border-radius: var(--rund);
+  box-shadow: none;
+}
+
+:root[data-design="klar"] .video__knopf:hover,
+:root[data-design="klar"] .video__knopf:focus-visible {
+  transform: none;
+  box-shadow: none;
+}
+
+:root[data-design="klar"] .video__zeichen {
+  box-shadow: none;
+}
+
+/* ---------- Navigationshilfen ---------- */
+
+:root[data-design="klar"] .sprungleiste__label {
+  color: var(--primaer-text);
+  font-size: var(--t-s);
+  font-weight: 600;
+}
+
+:root[data-design="klar"] .sprungleiste a {
+  display: inline-flex;
+  align-items: center;
+  min-height: 3rem;
+  padding: 0.5rem 1rem;
+  border-radius: 4px;
+  font-size: var(--t-s);
+  font-weight: 500;
+}
+
+:root[data-design="klar"] .brotkrumen ol,
+:root[data-design="klar"] .zurueck a {
+  font-size: var(--t-s);
+  font-weight: 500;
+}
+
+/* ---------- Startseite: Termine, Instagram, Partner ---------- */
+
+:root[data-design="klar"] .kalender,
+:root[data-design="klar"] .kalenderliste li:nth-child(3n + 2) .kalender,
+:root[data-design="klar"] .kalenderliste li:nth-child(3n) .kalender {
+  --kalender-flaeche: var(--flaeche);
+  --kalender-schrift: var(--schrift);
+  border: 1px solid var(--rand-leise);
+  border-radius: var(--rund);
+  box-shadow: none;
+}
+
+:root[data-design="klar"] .kalender:hover,
+:root[data-design="klar"] .kalender:focus-visible {
+  transform: none;
+  box-shadow: none;
+  border-color: var(--primaer-akzent);
+}
+
+:root[data-design="klar"] .kalender__name {
+  font-size: var(--t-ui);
+}
+
+:root[data-design="klar"] .kalender__aktion {
+  font-size: var(--t-s);
+  font-weight: 600;
+}
+
+:root[data-design="klar"] .instabeitrag {
+  border: 1px solid var(--rand-leise);
+  border-radius: var(--rund);
+  box-shadow: none;
+  overflow: hidden;
+}
+
+:root[data-design="klar"] .instabeitrag:hover,
+:root[data-design="klar"] .instabeitrag:focus-within {
+  transform: none;
+  box-shadow: none;
+  border-color: var(--primaer-akzent);
+}
+
+:root[data-design="klar"] .instabeitrag__bild {
+  border-bottom: 1px solid var(--rand-leise);
+}
+
+:root[data-design="klar"] .instabeitrag__plakette,
+:root[data-design="klar"] .instaraster li:nth-child(4n + 2) .instabeitrag__plakette,
+:root[data-design="klar"] .instaraster li:nth-child(4n + 3) .instabeitrag__plakette {
+  transform: none;
+  box-shadow: none;
+  border: 2px solid var(--tinte);
+  border-radius: var(--rund);
+}
+
+:root[data-design="klar"] .partnergitter__kachel {
+  border: 1px solid var(--rand-leise);
+  border-radius: var(--rund);
+  box-shadow: none;
+}
+
+:root[data-design="klar"] .partnergitter__kachel:hover {
+  transform: none;
+  box-shadow: none;
+  border-color: var(--primaer-akzent);
+}
+
+/* ---------- Fuß ---------- */
+
+:root[data-design="klar"] .fuss {
+  border-top: 1px solid var(--fuss-linie);
+}
+
+:root[data-design="klar"] .fuss__titel {
+  font-size: var(--t-s);
+  border-bottom: 1px solid var(--fuss-linie);
+}
+
+/* ---------- Druck: immer hell, auch wenn der dunkle Satz aktiv ist ---------- */
+
+@media print {
+  :root[data-design="klar"] {
+    --papier: #ffffff !important;
+    --papier2: #f3f4f6 !important;
+    --flaeche: #ffffff !important;
+    --schrift: #000000 !important;
+    --grau: #333333 !important;
+    --rand: #000000 !important;
+    --link: #1e40af !important;
+    --orange-tief: #1e40af !important;
+    --rand-leise: #999999 !important;
+    --linie: #999999 !important;
+    --hinweis-flaeche: #ffffff !important;
+    --fuss-flaeche: #ffffff !important;
+    color-scheme: light;
+  }
+}
