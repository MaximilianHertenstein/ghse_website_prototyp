+}
+
+/* Dropdowns ab 1200 px: dieselbe Struktur (Hover und Tastaturfokus), aber
+   sie bleiben kurz sichtbar, wenn der Zeiger die Fläche schräg verlässt. */
+@media (min-width: 1200px) {
+  :root[data-design="klar"] .menue ul.menue__tafel {
+    display: block;
+    visibility: hidden;
+    opacity: 0;
+    border: 1px solid var(--rand-leise);
