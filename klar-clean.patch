+  --hinweis-rand: var(--primaer-text);
+  --warn-flaeche: #451a03;
+  --warn-rand: var(--warnung);
+
+  --wert-blau: #114c92;
+  --wert-gelb: #f6dc56;
+  --wert-orange: #ee7330;
+
+  --fuss-flaeche: #0b1220;
+  --fuss-schrift: var(--text);
+  --fuss-titel: var(--text);
+  --fuss-linie: var(--rand-leise);
+  --fuss-link: var(--primaer-text);
