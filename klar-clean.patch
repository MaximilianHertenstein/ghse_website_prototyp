+  font-family: var(--schriftstapel-display);
+}
+
+:root[data-design="klar"] h1,
+:root[data-design="klar"] h2,
+:root[data-design="klar"] h3,
+:root[data-design="klar"] .hero__titel,
+:root[data-design="klar"] .karte__titel,
+:root[data-design="klar"] .karte__block-titel,
+:root[data-design="klar"] .zeitgruppe__titel,
+:root[data-design="klar"] .kasten h2,
+:root[data-design="klar"] .fliesstext > h2,
+:root[data-design="klar"] .fliesstext > h3,
+:root[data-design="klar"] .zeile__titel,
+:root[data-design="klar"] .infozeile__titel,
+:root[data-design="klar"] .konten__titel,
+:root[data-design="klar"] .kalender__name,
+:root[data-design="klar"] .hero__ticket-datum,
+:root[data-design="klar"] .karte--text .karte__datum,
+:root[data-design="klar"] .service h3 {
+  font-weight: 600;
+}
+
+:root[data-design="klar"] h1,
+:root[data-design="klar"] h2,
+:root[data-design="klar"] h3 {
