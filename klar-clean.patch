+}
+
+/* Zweittext in Karten und Listen: 18 px statt 16 px – für diese Zielgruppe
+   ist 16 px die Untergrenze, nicht der Normalfall. */
+:root[data-design="klar"] .karte__text,
+:root[data-design="klar"] .service p,
+:root[data-design="klar"] .zeile__beschreibung,
+:root[data-design="klar"] .infozeile__text,
+:root[data-design="klar"] .instabeitrag__text {
