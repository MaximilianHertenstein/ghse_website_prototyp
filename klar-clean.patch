diff --git a/hugo-klar.toml b/hugo-klar.toml
new file mode 100644
index 0000000..42a75c5
--- /dev/null
+++ b/hugo-klar.toml
@@ -0,0 +1,12 @@
+# Zweite Gestaltungsvariante „klar“ (ruhig, gut lesbar, große Schrift).
+# Gleiche Inhalte, gleiche Templates, gleiche Menüs – nur klar.css kommt dazu.
+#
+# Bau (Beispiel, Basis-URL der Hauptvariante vorausgesetzt):
+#   hugo --baseURL "$BASE_URL" --minify --gc
+#   hugo --config hugo.toml,hugo-klar.toml --baseURL "${BASE_URL}klar/" --destination public/klar --minify --gc
+#
+# Wichtig: Die Hauptvariante zuerst bauen, die zweite danach in den
+# Unterordner – Hugo leert das Zielverzeichnis nicht von selbst.
+
+[params]
+design = "klar"
diff --git a/layouts/_partials/haupt-url.html b/layouts/_partials/haupt-url.html
new file mode 100644
index 0000000..8cb8eb3
--- /dev/null
+++ b/layouts/_partials/haupt-url.html
@@ -0,0 +1,8 @@
+{{- /* Adresse einer Seite in der Hauptvariante.
+       Hauptvariante: .Permalink. Variante „klar“ (baseURL endet auf klar/):
+       dieselbe Seite ohne den Unterordner. Aufruf: partial "haupt-url.html" . */ -}}
+{{- $url := .Permalink -}}
+{{- if eq site.Params.design "klar" -}}
+  {{- $url = strings.Replace $url site.BaseURL (strings.TrimSuffix "klar/" site.BaseURL) 1 -}}
+{{- end -}}
+{{- return $url -}}
diff --git a/layouts/_partials/schriften-klar.html b/layouts/_partials/schriften-klar.html
new file mode 100644
index 0000000..f4c0c0e
--- /dev/null
+++ b/layouts/_partials/schriften-klar.html
@@ -0,0 +1,14 @@
+{{- /* Schriften der Variante „klar“ (Design-System Clean): Roboto für Text,
+       Poppins für Überschriften. Dateien liegen in assets/fonts/klar/ und
+       werden nur im klar-Bau veröffentlicht (mit Hash im Namen); die
+       Hauptvariante lädt weiter nur Inter. Zeichensatz wie bei Inter:
+       Latin-Ausschnitt. */ -}}
+{{- $roboto := resources.Get "fonts/klar/roboto-var-latin.woff2" | fingerprint -}}
+{{- $poppins := resources.Get "fonts/klar/poppins-600-latin.woff2" | fingerprint -}}
+{{- $bereich := "U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD" -}}
+<link rel="preload" href="{{ $roboto.RelPermalink }}" as="font" type="font/woff2" crossorigin>
+<link rel="preload" href="{{ $poppins.RelPermalink }}" as="font" type="font/woff2" crossorigin>
+<style>
+@font-face{font-family:"Roboto";src:url({{ $roboto.RelPermalink }}) format("woff2");font-weight:100 900;font-style:normal;font-display:swap;unicode-range:{{ $bereich | safeCSS }}}
+@font-face{font-family:"Poppins";src:url({{ $poppins.RelPermalink }}) format("woff2");font-weight:600;font-style:normal;font-display:swap;unicode-range:{{ $bereich | safeCSS }}}
+</style>
