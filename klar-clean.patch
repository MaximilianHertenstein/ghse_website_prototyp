+  font-size: var(--t-xs);
+}
+
+:root[data-design="klar"] .chip--akzent,
+:root[data-design="klar"] .chip:active {
+  transform: none;
+  box-shadow: none;
+}
+
+:root[data-design="klar"] .marke,
+:root[data-design="klar"] .chip[data-kategorie="teilzeitschularten"],
+:root[data-design="klar"] .marke[data-kategorie="teilzeitschularten"] {
+  transform: none;
+}
+
+:root[data-design="klar"] .marke {
+  border: 0;
+  border-radius: 4px;
+  font-size: var(--t-xs);
+  font-weight: 500;
+  padding: 0.25rem 0.5rem;
+}
+
+:root[data-design="klar"] .karte__koerper .marke {
+  align-self: flex-start;
+}
+
+:root[data-design="klar"] .meta time {
+  border: 0;
+  border-radius: 4px;
+  padding: 0.125rem 0.5rem;
+}
+
+/* Schaltfläche. Zustände: Standard, Hover (Unterstreichung + zweiter innerer
+   Rand), Fokus (siehe oben), Aktiv (dritter Rand), Deaktiviert (main.css). */
+:root[data-design="klar"] .btn {
+  font-size: var(--t-ui);
+  font-weight: 600;
+  line-height: 1.25;
+  min-height: 3rem;
+  padding: 0.5rem 1.5rem;
