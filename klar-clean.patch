+
+/* ---------- Basis ---------- */
+
+:root[data-design="klar"] body {
+  font-size: var(--t-m);
+  line-height: 1.6;
+}
+
+/* Keine Versalien, keine Sperrung: gilt für alles, auch für Pseudo-Elemente. */
+:root[data-design="klar"] *,
+:root[data-design="klar"] *::before,
+:root[data-design="klar"] *::after {
+  text-transform: none;
+  letter-spacing: normal;
