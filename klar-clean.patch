+/* ---------- Kopf, Leiste, Menü ---------- */
+
+:root[data-design="klar"] .leiste {
+  font-size: var(--t-xs);
+}
+
+:root[data-design="klar"] .leiste__innen {
+  padding-block: 0.25rem;
+}
