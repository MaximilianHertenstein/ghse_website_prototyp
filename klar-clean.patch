+
+/* Nichts hüpft: weder transform (je Komponente unten) noch translate.
+   !important, weil main.css die Hover-Bewegung an einzelnen Stellen über
+   translate setzt und künftig weitere hinzukommen können. */
+:root[data-design="klar"] *,
+:root[data-design="klar"] *::before,
+:root[data-design="klar"] *::after {
+  translate: none !important;
+}
+
+:root[data-design="klar"] h1,
