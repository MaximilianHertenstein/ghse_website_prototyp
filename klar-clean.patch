+  transform: none;
+  box-shadow: inset 0 0 0 2px currentColor;
+  text-decoration: underline;
+}
+
+:root[data-design="klar"] .btn:active {
+  transform: none;
+  box-shadow: inset 0 0 0 3px currentColor;
+}
+
+/* Primäraktion: gefüllt in Clean-Blau (hell) bzw. hellem Blau (dunkel). */
+:root[data-design="klar"] .btn--akzent {
