+
+/* Buttons im Fließtext: .fliesstext a färbt sonst auch sie wie einen Link
+   (im Dunkelmodus gelb auf gelb in main.css). Schrift wie bei Buttons. */
+:root[data-design="klar"] .fliesstext a.btn {
+  text-decoration: none;
+  font-weight: 600;
+  color: var(--schrift);
+}
+
+:root[data-design="klar"] .fliesstext a.btn--akzent {
