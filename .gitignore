# Produktionsausgabe – wird bei jedem Push per GitHub Actions neu gebaut.
/public/

# Hugo-Buildzustand (zeitgestempelt, würde jedes Mal ungleich sein)
.hugo_build.lock

# Arbeitsmaterial: Screenshots, Lighthouse-Reports und Roh-Extrakte der
# Originalseite. Nicht Teil der Website – für den Repository-Commit bleibt es
# lokal. Wer sie mitversionieren will, entfernt die zwei Zeilen.
/qa/*
!qa/*.py
/recherche/

# Betriebssystem- und Editor-Reste
.DS_Store
Thumbs.db
*.swp
*~

# Bytecode der Hilfsskripte
__pycache__/
*.pyc

# design-taste-frontend: 40-MB-Skill-Kit mit Demo-Fotos und Stand-ins.
# Lokal als Werkzeug installiert, nicht Teil der Website. Der Eintrag in
# skills-lock.json bleibt als Manifest erhalten; die Skill-Dateien lassen
# sich darüber neu installieren.
/.agents/skills/design-taste-frontend/
/.agents/skills/hallmark/
/.taste-skill/
/shots/

# Impeccable: lokale Hook-/Tool-Konfiguration (Consent, Projektstatus).
/.impeccable/

# Python-Virtualenv der QA-Werkzeuge. Es hat ein eigenes .gitignore; der
# Eintrag hier macht die Absicht im versionierten Repo sichtbar.
/.venv/
/venv/
/env/

# Hugo-Ressourcen-Cache (Bildverarbeitung/Hugo Pipes, generiert)
/resources/

# Lokale Node-/Python-Werkzeugcaches
/node_modules/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.cache/

# Editor-, Log- und Merge-Reste
.idea/
.vscode/
*.log
*.orig
*.rej

# Lokale Umgebungsdateien (nie versehentlich einchecken)
.env
.env.*
!.env.example
